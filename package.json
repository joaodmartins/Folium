{
  "name": "folium",
  "version": "0.0.0",
  "private": true,
  "description": "Your personal digital library: Markdown files turned into digital books.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:preview": "E2E_TARGET=preview playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.1",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "dompurify": "^3.5.0",
    "markdown-it": "^15.0.3"
  }
}
